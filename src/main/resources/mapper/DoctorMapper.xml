<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.test1.mapper.DoctorMapper">

    <!--
      医生多条件组合查询：
        name   姓名模糊匹配   deptId  科室精确匹配   titleId 职称精确匹配
        phone / idCard 精确匹配（唯一键）  gender 性别   status 在诊状态
      所有参数均使用 #{}，由 JDBC PreparedStatement 预编译绑定。
    -->
    <sql id="doctorWhere">
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
            <if test="titleId != null">
                AND title_id = #{titleId}
            </if>
            <if test="phone != null and phone != ''">
                AND phone = #{phone}
            </if>
            <if test="idCard != null and idCard != ''">
                AND id_card = #{idCard}
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*) FROM doctor
        <include refid="doctorWhere"/>
    </select>

    <select id="selectByCondition" resultType="com.example.test1.entity.Doctor">
        SELECT doctor_id, doctor_no, dept_id, title_id, name, gender, phone, id_card,
               status, created_at, updated_at
        FROM doctor
        <include refid="doctorWhere"/>
        ORDER BY doctor_id ASC
        LIMIT #{offset}, #{size}
    </select>

</mapper>
