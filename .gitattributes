# 统一换行符策略：仓库内一律以 LF 存储，跨平台协作不会产生无意义的整文件 diff
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则无法执行
*.cmd text eol=crlf
*.bat text eol=crlf

# Maven 包装脚本
/mvnw text eol=lf
/mvnw.cmd text eol=crlf

# 二进制文件不做换行转换
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
